{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "postman": "node scripts/generate-postman.js"
  },
  "dependencies": {
    "@temporalio/client": "^1.13.1",
    "@temporalio/common": "^1.13.1",
    "@temporalio/worker": "^1.13.1",
    "@temporalio/workflow": "^1.13.1",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
